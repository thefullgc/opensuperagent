{
  "name": "opensuperagent",
  "version": "0.1.1",
  "description": "A self-hosted, open-source Super-agent inspired by DeepSeek: one entry point, multiple tasks, persistent progress.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thefullgc/opensuperagent.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "seed",
    "web/dist",
    "config.example.yaml",
    "README.en.md",
    "resource"
  ],
  "bin": {
    "opensuperagent": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "prepack": "node scripts/prepare-package.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && npm run build:web",
    "build:web": "npm --prefix web run build",
    "dev": "tsx src/cli.ts",
    "dev:web": "npm --prefix web run dev",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:integrations": "tsx --test test/adapters.test.ts test/feishu-websocket.test.ts test/delivery-concurrency.test.ts test/model-routing.test.ts test/settings.test.ts test/llm-validation.test.ts",
    "verify:live": "tsx scripts/verify-native-live.ts",
    "verify:catalog": "tsx scripts/verify-catalog-live.ts",
    "test:pizza": "tsx --test test/pizza-runtime.test.ts test/model-routing.test.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "verify:package": "node scripts/verify-npm-package.mjs",
    "prepublishOnly": "npm run typecheck && npm --prefix web run lint && npm test"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@tomsun28/pizza": "0.5.1",
    "file-type": "^21.3.4",
    "yaml": "^2.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "protobufjs": "^7.6.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "ws": "^8.22.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thefullgc/opensuperagent.git"
  },
  "homepage": "https://github.com/thefullgc/opensuperagent#readme",
  "bugs": {
    "url": "https://github.com/thefullgc/opensuperagent/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  }
}
